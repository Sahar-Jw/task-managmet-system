NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=your_db_user
DB_PASSWORD=replace_with_strong_database_password
DB_NAME=task_pm_system

DB_SYNCHRONIZE=false
DB_LOGGING=true

JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_32_char_secret
JWT_REFRESH_EXPIRES_IN=60d

BCRYPT_SALT_ROUNDS=12
FAILED_LOGIN_LOCK_THRESHOLD=5
FAILED_LOGIN_LOCK_MINUTES=15

MAX_UPLOAD_FILE_SIZE_MB=25
CORS_ORIGIN=http://localhost:3001

# ── Mail (SMTP) ─────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_smtp_username
MAIL_PASS=your_smtp_password
MAIL_FROM="DMS <no-reply@example.com>"
