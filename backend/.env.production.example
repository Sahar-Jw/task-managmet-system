NODE_ENV=production
API_PREFIX=api/v1
PUBLIC_BASE_PATH=api
TRUST_PROXY=1

DB_HOST=
DB_PORT=5432
DB_USERNAME=postgres
DB_NAME=postgres
DB_PASSWORD=
DB_SYNCHRONIZE=false
DB_LOGGING=false

JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=60d

BCRYPT_SALT_ROUNDS=12
FAILED_LOGIN_LOCK_THRESHOLD=5
FAILED_LOGIN_LOCK_MINUTES=15
MAX_UPLOAD_FILE_SIZE_MB=25

# Must be the public URL of the frontend container on Ghaymah
CORS_ORIGIN=
FRONTEND_URL=

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="TMS <you@example.com>"

RUN_MIGRATIONS=true
RUN_SEED=false
SEED_USER_PASSWORD=

# --- S3 object storage (Ghaymah). Setting S3_BUCKET turns S3 mode on;
# --- leave it empty to keep using the local ./storage folder.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=https://s3.cumin.dev
AWS_REGION=us-east-1
S3_BUCKET=
S3_FORCE_PATH_STYLE=true
